{
  "name": "tjworx-supplier-mail-preview",
  "main": "index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {"crons": []},
  "d1_databases": [{"binding":"DB","database_name":"REPLACE_PREVIEW_CRM","database_id":"REPLACE_PREVIEW_D1_ID"}],
  "r2_buckets": [{"binding":"CRM_FILES","bucket_name":"REPLACE_PREVIEW_FILES","jurisdiction":"eu"}],
  "vars": {
    "CRM_COMPANY_ID":"maatwerkkunststof",
    "CRM_RELEASE_ENV":"preview",
    "CRM_PUBLIC_URL":"https://replace-preview.example.invalid",
    "CRM_OUTLOOK_SUPPLIER_ENABLED":"false",
    "CRM_OUTLOOK_AUTO_SYNC":"false",
    "CRM_OUTLOOK_CLIENT_ID":"",
    "CRM_OUTLOOK_TENANT_ID":"",
    "CRM_OUTLOOK_STORAGE_ID":""
  }
  // CRM_OUTLOOK_CLIENT_SECRET and CRM_INTEGRATIONS_KEY are secrets, never here.
  // Same preview DB/R2/marker/credentials as the CRM. No extra live resources.
}
